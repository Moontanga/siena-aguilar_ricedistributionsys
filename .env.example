# Neon pooled connection string for application queries (Pool driver supports transactions)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Generate with: openssl rand -base64 32 (at least 32 characters)
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Optional first-owner bootstrap values; only used by scripts/admin:create, never exposed to the browser
ADMIN_NAME=System Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
# Optional Google Sheets integration (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
